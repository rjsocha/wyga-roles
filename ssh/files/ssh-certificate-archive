#!/usr/bin/env python3
"""The archive of issued SSH host certificates.

  prune DIR              remove the expired certificates of a host
  types DIR TYPE...      revoke the certificates of DIR whose key type is not listed
  revoked BASE           write BASE/ssh/revoked.json from BASE/ssh/certificate

The archive is <group>/<hostname>/<fingerprint>.pub, one certificate per
file; <fingerprint>.revoked is a revoked one. Certificates are read with
ssh-keygen -L.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import time

TYPES = (
    ('ssh-ed25519-cert-', 'ed25519'),
    ('ssh-rsa-cert-', 'rsa'),
    ('ecdsa-sha2-', 'ecdsa'),
)
STAMP = '%Y-%m-%dT%H:%M:%S'


class Certificate(object):
    def __init__(self, path):
        self.path = path
        out = subprocess.run(['ssh-keygen', '-L', '-f', path], check=True, capture_output=True, text=True).stdout
        field = {}
        for line in out.splitlines():
            m = re.match(r'^\s+(Type|Public key|Serial|Valid): (.*)$', line)
            if m:
                field[m.group(1)] = m.group(2).strip()
        missing = [name for name in ('Type', 'Public key', 'Serial', 'Valid') if name not in field]
        if missing:
            raise SystemExit('%s: no %s in the output of ssh-keygen -L' % (path, ', '.join(missing)))
        self.key = field['Type'].split()[0]
        self.type = next((name for prefix, name in TYPES if self.key.startswith(prefix)), 'unknown')
        self.fingerprint = field['Public key'].split()[1]
        self.serial = int(field['Serial'])
        m = re.search(r'(?:to|before) (\S+)$', field['Valid'])
        self.until = time.mktime(time.strptime(m.group(1), STAMP)) if m else None

    def expired(self, now):
        return self.until is not None and self.until < now


def files(directory, *suffixes):
    return sorted(
        os.path.join(directory, name) for name in os.listdir(directory)
        if name.endswith(suffixes) and os.path.isfile(os.path.join(directory, name))
    )


def prune(directory):
    now = time.time()
    for path in files(directory, '.pub', '.revoked'):
        if Certificate(path).expired(now):
            os.remove(path)
            print('expired %s' % path)


def types(directory, keep):
    if not os.path.isdir(directory):
        return
    for path in files(directory, '.pub'):
        if Certificate(path).type not in keep:
            os.rename(path, path[:-len('.pub')] + '.revoked')
            print('revoked %s' % path)


def known(base, hostname):
    return any(os.path.isfile(os.path.join(base, 'policy', hostname + suffix)) for suffix in ('', '.yaml', '.yml'))


def revoked(base):
    archive = os.path.join(base, 'ssh', 'certificate')
    output = os.path.join(base, 'ssh', 'revoked.json')
    if not os.path.isdir(archive):
        return
    now = time.time()
    found = []

    def revoke(certificate, reason):
        if certificate.expired(now):
            return
        found.append(certificate)
        name = os.path.relpath(certificate.path, archive).rsplit('.', 1)[0]
        print('%-12s %s' % (reason, name), file=sys.stderr)

    for group in sorted(os.listdir(archive)):
        if not os.path.isdir(os.path.join(archive, group)):
            continue
        for hostname in sorted(os.listdir(os.path.join(archive, group))):
            directory = os.path.join(archive, group, hostname)
            if not os.path.isdir(directory):
                continue
            for path in files(directory, '.revoked'):
                revoke(Certificate(path), 'revoked')
            current = [Certificate(path) for path in files(directory, '.pub')]
            if not known(base, hostname):
                for certificate in current:
                    revoke(certificate, 'no policy')
                continue
            newest = {}
            for certificate in current:
                if certificate.key not in newest or certificate.serial > newest[certificate.key].serial:
                    newest[certificate.key] = certificate
            for certificate in current:
                if newest[certificate.key] is not certificate:
                    revoke(certificate, 'superseded')

    entries = sorted(
        ({
            'fingerprint': c.fingerprint,
            'until': time.strftime(STAMP + 'Z', time.gmtime(c.until)) if c.until is not None else None,
        } for c in found),
        key=lambda entry: entry['fingerprint'],
    )
    sequence = 0
    if os.path.isfile(output):
        with open(output) as f:
            have = json.load(f)
        sequence = int(have.get('sequence', 0))
        if have.get('ssh') == entries:
            print('ssh/revoked.json: unchanged, sequence %d, %d revoked' % (sequence, len(entries)), file=sys.stderr)
            return
    sequence += 1
    document = {
        'version': 1,
        'sequence': sequence,
        'generated': time.strftime(STAMP + 'Z', time.gmtime(now)),
        'ssh': entries,
    }
    handle, tmp = tempfile.mkstemp(prefix='revoked.json.', dir=os.path.dirname(output))
    try:
        with os.fdopen(handle, 'w') as f:
            json.dump(document, f, indent=2)
            f.write('\n')
        os.chmod(tmp, 0o644)
        os.replace(tmp, output)
    except BaseException:
        os.unlink(tmp)
        raise
    print('ssh/revoked.json: sequence %d, %d revoked' % (sequence, len(entries)), file=sys.stderr)


def main(argv):
    if len(argv) == 3 and argv[1] == 'prune':
        prune(argv[2])
    elif len(argv) >= 3 and argv[1] == 'types':
        types(argv[2], argv[3:])
    elif len(argv) == 3 and argv[1] == 'revoked':
        revoked(argv[2])
    else:
        raise SystemExit(__doc__.strip())


if __name__ == '__main__':
    main(sys.argv)

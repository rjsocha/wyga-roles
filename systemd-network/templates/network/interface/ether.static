#jinja2: trim_blocks: True, lstrip_blocks: True
[Match]
Type={{ interface.type }}
Driver={{ interface.driver }}
{% if interface.mac is defined %}
PermanentMACAddress={{ interface.mac | upper }}
{% endif %}

[Network]
IPv6AcceptRA={{ interface.ra | default('no') | string }}
LinkLocalAddressing={{ interface.lla | default('ipv6') | string }}
{% for ip in interface.ip %}
Address={{ ip }}
{% endfor %}
{% if interface.dns is defined %}
DNS={{ interface.dns | ansible.utils.ipaddr('address') | join(' ') }}
{% endif %}
{% if interface.domains is defined %}
Domains={{ interface.domains if interface.domains is string else interface.domains | join(' ') }}
{% endif %}
LLMNR=no
{% for route in routes %}

[Route]
Destination={{ route.to if route.to != 'default'
                else ('::/0' if route.via | ansible.utils.ipv6 else '0.0.0.0/0') }}
Gateway={{ route.via }}
{% if route.onlink | default(false) %}
GatewayOnLink=yes
{% endif %}
{% endfor %}

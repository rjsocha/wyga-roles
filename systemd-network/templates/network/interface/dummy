#jinja2: trim_blocks: True, lstrip_blocks: True
[Match]
Name={{ interface.name }}

[Network]
{% for ip in interface.ip %}
Address={{ ip if '/' in ip else ip ~ '/32' }}
{% endfor %}
{% if interface.dns is defined %}
DNS={{ [ interface.dns ] | flatten | ansible.utils.ipaddr('address') | join(' ') }}
{% endif %}
{% if interface.domains is defined %}
Domains={{ interface.domains if interface.domains is string else interface.domains | join(' ') }}
{% endif %}
LLMNR=no
LLDP=no
IPv6AcceptRA=no
LinkLocalAddressing={{ 'yes' if interface.lla | default(false) else 'no' }}

[Link]
RequiredForOnline=no
